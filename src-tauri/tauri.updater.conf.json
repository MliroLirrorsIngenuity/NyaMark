{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyaMark Updater",
  "version": "../package.json",
  "identifier": "best.lolicon.nyamark.updater",
  "build": {
    "frontendDist": "updater"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "updater",
        "title": "NyaMark Updater",
        "url": "index.html",
        "width": 420,
        "height": 220,
        "minWidth": 420,
        "minHeight": 220,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
