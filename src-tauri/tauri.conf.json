{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyaMark",
  "version": "../package.json",
  "identifier": "best.lolicon.nyamark",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NyaMark",
        "width": 860,
        "height": 720,
        "minWidth": 826,
        "minHeight": 448,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn",
          "mdwn",
          "mdtxt"
        ],
        "name": "Markdown File",
        "description": "Markdown text file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "languages": [
          "ChineseSimplified",
          "English"
        ],
        "installMode": "both",
        "compression": "lzma"
      }
    }
  }
}
