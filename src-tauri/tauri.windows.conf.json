{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NyaMark",
        "width": 860,
        "height": 720,
        "minWidth": 826,
        "minHeight": 448,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "installMode": "both",
        "compression": "lzma",
        "startMenuFolder": "NyaMark"
      }
    }
  }
}
