{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main editor window and runtime editor-* spawn windows",
  "windows": [
    "main",
    "editor-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-effects",
    "core:window:allow-set-theme",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPDATA/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" }
      ]
    },
    "opener:default",
    "dialog:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
  ]
}
