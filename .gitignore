# Rust build output
/target/
**/target/

# Keep Cargo.lock for application; comment out next line if publishing a library
!Cargo.lock

# Incremental compilation cache (optional to ignore if you want faster local rebuilds only for you)
/.rustc_info.json

# Backup & temp files
*.rs.bk
*.bak
*.tmp
*.swp
*.swo

# Logs
*.log

# OS / Desktop junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
.vscode-test/
*.code-workspace

# Generated by some editors
*.iml

# Crash / profiling dumps
*.dmp
*.stackdump

# Egui / screenshots (uncomment if you start generating)
# screenshots/

# Optional assets cache (uncomment if large fonts or images should stay local)
# assets/fonts/

# Binaries (in case you copy releases into repo root)
*.exe
*.dll
*.so
*.dylib

# Coverage / reports (if you add coverage later)
coverage/

# Cargo fuzz / other tools
fuzz/
deny.toml
