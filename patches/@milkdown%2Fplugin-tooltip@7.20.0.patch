 //#region src/tooltip-provider.ts
+// NyaMark: the boxes of the text selected, for inline() to place a tooltip by
+// a line of it. A block taken whole has a box as wide as the page, and a
+// selection from the end of a line an empty one there: neither is text
+// selected. Only the blocks at either end are measured, the lines inline()
+// reads; a long selection was measured whole on each scroll.
+function selectedTextRects(view, from, to) {
+	const blocks = [];
+	view.state.doc.nodesBetween(from, to, (node, pos) => {
+		if (node.isTextblock) blocks.push([]);
+		else if (node.isText) blocks[blocks.length - 1]?.push([Math.max(from, pos), Math.min(to, pos + node.nodeSize)]);
+	});
+	const range = document.createRange();
+	const measure = (spans) => spans.flatMap(([start, end]) => {
+		const head = view.domAtPos(start, 1);
+		const tail = view.domAtPos(end, -1);
+		range.setStart(head.node, head.offset);
+		range.setEnd(tail.node, tail.offset);
+		return Array.from(range.getClientRects()).filter((rect) => rect.width > 0);
+	});
+	let first = 0;
+	let rects = [];
+	while (first < blocks.length && !(rects = measure(blocks[first])).length) first++;
+	for (let last = blocks.length - 1; last > first; last--) {
+		const end = measure(blocks[last]);
+		if (end.length) return [...rects, ...end];
+	}
+	return rects.length ? rects : [posToDOMRect(view, from, to)];
+}
